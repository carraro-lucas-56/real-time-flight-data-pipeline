# Copy this file to .env and fill in your own values.
# Authenticate to GCP with: export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# GENERAL IN GCP
PROJECT_ID=

# PUB/SUB
PUB_SUB_TOPIC=projects/<project-id>/topics/<topic>
PUB_SUB_SUBSCRIPTION=

# BEAM'S BUCKETS
TEMP_LOCATION=gs://<bucket>/temp
STAGING_FOLDER=gs://<bucket>/staging

# DATA BUCKETS
BRONZE_FOLDER=gs://<bucket>/bronze
SILVER_FOLDER=gs://<bucket>/silver
GOLD_FOLDER=gs://<bucket>/gold
BAD_RECORDS_FOLDER=gs://<bucket>/bad_records

# BIGQUERY
DATASET_ID=aircraft_metrics
AIRCRAFTS_PER_COUNTRY_TABLE_ID=<project-id>:aircraft_metrics.<table>
AIRCRAFTS_VELOCITY_TABLE_ID=<project-id>:aircraft_metrics.<table>
AIRCRAFT_VERTICAL_ANOMALIES_TABLE_ID=<project-id>:aircraft_metrics.<table>

# OPENSKY API SECRETS
CLIENT_ID=
CLIENT_SECRET=
